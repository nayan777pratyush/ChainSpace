# Never commit your real .env file.

# Optional: only needed for Sepolia contract deployment.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
DEPLOYER_PRIVATE_KEY=YOUR_SEPOLIA_DEPLOYER_PRIVATE_KEY

# Frontend public configuration.
# Local Hardhat defaults are already provided by the app.
NEXT_PUBLIC_CHAIN_ID=1337
NEXT_PUBLIC_NETWORK_NAME=Hardhat Local
NEXT_PUBLIC_GREETER_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_VOTING_ADDRESS=

# Optional explorer base URL for transaction links.
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io